{
  "$schema": "https://opencode.ai/config.json",
  "skills": { "paths": [".aidlc/skills"] },
  "instructions": ["aidlc/spaces/default/memory/**/*.md"],
  "permission": {
    "edit": {
      "*": "allow",
      ".aidlc/tools/**": "ask",
      ".aidlc/hooks/**": "ask"
    },
    "bash": {
      "*": "ask",
      "aidlc engine *": "allow"
    }
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  }
}
