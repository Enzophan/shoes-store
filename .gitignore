# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

node_modules
dist
.dist-ssr
*.local

# Editor directories and files (including workspace settings)
.vscode/*!!.vscode/extensions.json.idea.DS_Store
.idea.DS_Store
*.suo
.ntvs.*
.njsproj
.sln.sw?*

# AI-DLC — the committed-vs-ignored split. Per-user session cursors are ignored to prevent per-user navigation from becoming shared state that would cause conflicts on intent creation/switching:
aidlc/active-space
aidlc/spaces/*/intents/active-intent
# Machine-local runtime / derived—regenerated per machine. The clone-id token names this clone's audit shard; it MUST stay machine-local (gitignored) or every clone from a commit would share a shard and git-conflict:
aidlc/.aidlc-clone-id
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json

# DocumentKB staged transaction scratch: `onboard` stages a document into `.journal/<txn-id>/`. Per-commit and the rule exists to prevent concurrent sync conflicts.
aidlc/spaces/*/knowledge/documentkb/.journal/

# Redacted diagnostic reports (/aidlc --doctor - export): regenerated, meant to be shared then deleted—machine-local derived output, never shared truth:
aidlc/diagnostics/*
aidlc/code-analysis/reports/*
aidlc/workflow-results/*.json*
aidlc/runtime-logs/error.log
aidlc/sensor-alerts.json

# Build artifacts (for future inspection only)
.next
*.lock files-* node_modules/.cache/ dist-*/node_modules/package-lock.json* pnpm-store/store/ packages/*/dist/dist-dense/index.js build-debug/*.js 2>/dev/null || true

# IDE / editor workspace settings and cache:
.vscode/settings.json!.vscode/extensions.json.idea.DS_Store
.idea.*
